{
  "name": "template-saas-export-service",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prestart": "lsof -nP -iTCP:4101 -sTCP:LISTEN 2>/dev/null | awk 'NR>1 {print $2}' | xargs -r kill -9 || true",
    "prestart:dev": "lsof -nP -iTCP:4101 -sTCP:LISTEN 2>/dev/null | awk 'NR>1 {print $2}' | xargs -r kill -9 || true",
    "prestart:watch": "lsof -nP -iTCP:4101 -sTCP:LISTEN 2>/dev/null | awk 'NR>1 {print $2}' | xargs -r kill -9 || true",
    "prestart:debug": "lsof -nP -iTCP:4101 -sTCP:LISTEN 2>/dev/null | awk 'NR>1 {print $2}' | xargs -r kill -9 || true",
    "build": "tsc --noEmit --incremental false --declaration false --sourceMap false",
    "start": "MOCK_MODE=true JWT_ACCESS_SECRET=change_me_access JWT_REFRESH_SECRET=change_me_refresh DATABASE_URL=postgresql://user:pass@localhost:5432/db REDIS_HOST=localhost REDIS_PORT=6379 node -r ts-node/register/transpile-only src/main.ts",
    "start:dev": "MOCK_MODE=true JWT_ACCESS_SECRET=change_me_access JWT_REFRESH_SECRET=change_me_refresh DATABASE_URL=postgresql://user:pass@localhost:5432/db REDIS_HOST=localhost REDIS_PORT=6379 node -r ts-node/register/transpile-only src/main.ts",
    "start:watch": "MOCK_MODE=true JWT_ACCESS_SECRET=change_me_access JWT_REFRESH_SECRET=change_me_refresh DATABASE_URL=postgresql://user:pass@localhost:5432/db REDIS_HOST=localhost REDIS_PORT=6379 node --watch -r ts-node/register/transpile-only src/main.ts",
    "start:debug": "MOCK_MODE=true JWT_ACCESS_SECRET=change_me_access JWT_REFRESH_SECRET=change_me_refresh DATABASE_URL=postgresql://user:pass@localhost:5432/db REDIS_HOST=localhost REDIS_PORT=6379 node --inspect -r ts-node/register/transpile-only src/main.ts",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.2",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.18.0",
    "bullmq": "^5.12.14",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "joi": "^17.13.3",
    "nestjs-pino": "^4.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.3.2",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.16.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prisma": "^5.18.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
